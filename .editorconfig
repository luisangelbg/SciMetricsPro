# Formato común del código (sustituye a un formateador automático: no hay Node en esta máquina)
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{ps1,bat}]
end_of_line = crlf
